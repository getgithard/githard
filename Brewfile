# What GitHard's scripts need, in a form tools can read: `brew bundle` installs it on a Mac,
# and scripts/check.sh checks each one is on the PATH. Linux has the same tools under the same names.
brew "bash"        # every script
brew "gh"          # the GitHub CLI: every call to GitHub goes through it
brew "git"         # tags, archives and diffs
brew "curl"        # link and header checks
brew "jq"          # reading gh's JSON
brew "python@3"    # csp-headers.py and a few one-off checks
brew "rsync"       # bootstrap-dotgithub.sh
brew "shellcheck"  # CI lint for the scripts above
